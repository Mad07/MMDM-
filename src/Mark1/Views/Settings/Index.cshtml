@model Mark1.Models.ViewModels.SettingsViewModel
@{
    ViewData["Title"] = Localizer["Settings_Title"];
}

<h1 class="page-title">@Localizer["Settings_Title"]</h1>

@if (TempData["SettingsError"] != null)
{
    <div class="alert alert-warning">@TempData["SettingsError"]</div>
}

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(Model.ActiveTab == "categories" ? "active" : "")" asp-action="Index" asp-route-tab="categories">@Localizer["Settings_ManageCategories"]</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.ActiveTab == "accounts" ? "active" : "")" asp-action="Index" asp-route-tab="accounts">@Localizer["Settings_ManageAccounts"]</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.ActiveTab == "currency" ? "active" : "")" asp-action="Index" asp-route-tab="currency">@Localizer["Settings_CurrencyRate"]</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(Model.ActiveTab == "users" ? "active" : "")" asp-action="Index" asp-route-tab="users">@Localizer["Settings_ManageUsers"]</a>
    </li>
</ul>

@if (Model.ActiveTab == "categories")
{
    <div class="settings-panel">
        <form asp-action="AddCategory" method="post" class="d-flex gap-2 mb-3 align-items-center flex-wrap">
            <input type="text" name="name" class="form-control" placeholder="@Localizer["Settings_NewCategoryPlaceholder"]" required style="max-width:260px;" />
            <div class="form-check">
                <input type="checkbox" class="form-check-input" name="isForExpenses" value="true" checked id="newCategoryExpenses" />
                <label class="form-check-label" for="newCategoryExpenses">@Localizer["Nav_Expenses"]</label>
            </div>
            <div class="form-check">
                <input type="checkbox" class="form-check-input" name="isForIncomes" value="true" checked id="newCategoryIncomes" />
                <label class="form-check-label" for="newCategoryIncomes">@Localizer["Nav_Incomes"]</label>
            </div>
            <button type="submit" class="btn btn-primary">@Localizer["Common_Add"]</button>
        </form>
        <ul class="list-group">
            @foreach (var category in Model.Categories)
            {
                <li class="list-group-item rename-item">
                    <div class="d-flex justify-content-between align-items-center item-view flex-wrap gap-2">
                        <span>@CategoryDisplay.Localize(category.Name, Localizer)</span>
                        <div class="d-flex align-items-center gap-3 flex-wrap">
                            <div class="d-flex align-items-center gap-1">
                                <form asp-action="ToggleCategoryExpenseUse" asp-route-id="@category.Id" method="post" class="d-inline ajax-toggle-form">
                                    <input type="checkbox" class="form-check-input" checked="@category.IsForExpenses" title="@Localizer["Settings_UseForExpenses"]" />
                                </form>
                                <span class="category-scope-label">@Localizer["Nav_Expenses"]</span>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <form asp-action="ToggleCategoryIncomeUse" asp-route-id="@category.Id" method="post" class="d-inline ajax-toggle-form">
                                    <input type="checkbox" class="form-check-input" checked="@category.IsForIncomes" title="@Localizer["Settings_UseForIncomes"]" />
                                </form>
                                <span class="category-scope-label">@Localizer["Nav_Incomes"]</span>
                            </div>
                            <div class="d-flex gap-1">
                                <button type="button" class="btn btn-sm btn-outline-secondary btn-icon toggle-rename" title="@Localizer["Common_Edit"]">
                                    <i class="bi bi-pencil-square"></i>
                                    <span class="visually-hidden">@Localizer["Common_Edit"]</span>
                                </button>
                                <form asp-action="DeleteCategory" method="post" class="d-inline" onsubmit="return confirm('@Localizer["Settings_ConfirmDeleteCategory"]');">
                                    <input type="hidden" name="id" value="@category.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger btn-icon" title="@Localizer["Common_Delete"]">
                                        <i class="bi bi-trash"></i>
                                        <span class="visually-hidden">@Localizer["Common_Delete"]</span>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                    <form asp-action="RenameCategory" method="post" class="d-none item-rename-form d-flex gap-2 mt-2">
                        <input type="hidden" name="id" value="@category.Id" />
                        <input type="text" name="name" class="form-control form-control-sm" value="@category.Name" required />
                        <button type="submit" class="btn btn-sm btn-primary">@Localizer["Common_Save"]</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary cancel-rename">@Localizer["Common_Cancel"]</button>
                    </form>
                </li>
            }
        </ul>
    </div>
}
else if (Model.ActiveTab == "accounts")
{
    <div class="settings-panel">
        <form asp-action="AddAccount" method="post" class="d-flex gap-2 mb-3">
            <input type="text" name="name" class="form-control" placeholder="@Localizer["Settings_NewAccountPlaceholder"]" required />
            <button type="submit" class="btn btn-primary">@Localizer["Common_Add"]</button>
        </form>
        <ul class="list-group">
            @foreach (var account in Model.Accounts)
            {
                <li class="list-group-item rename-item">
                    <div class="d-flex justify-content-between align-items-center item-view">
                        <span>@AccountDisplay.Localize(account.Name, Localizer)</span>
                        <div class="d-flex gap-1">
                            <button type="button" class="btn btn-sm btn-outline-secondary btn-icon toggle-rename" title="@Localizer["Common_Edit"]">
                                <i class="bi bi-pencil-square"></i>
                                <span class="visually-hidden">@Localizer["Common_Edit"]</span>
                            </button>
                            <form asp-action="DeleteAccount" method="post" class="d-inline" onsubmit="return confirm('@Localizer["Settings_ConfirmDeleteAccount"]');">
                                <input type="hidden" name="id" value="@account.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger btn-icon" title="@Localizer["Common_Delete"]">
                                    <i class="bi bi-trash"></i>
                                    <span class="visually-hidden">@Localizer["Common_Delete"]</span>
                                </button>
                            </form>
                        </div>
                    </div>
                    <form asp-action="RenameAccount" method="post" class="d-none item-rename-form d-flex gap-2 mt-2">
                        <input type="hidden" name="id" value="@account.Id" />
                        <input type="text" name="name" class="form-control form-control-sm" value="@account.Name" required />
                        <button type="submit" class="btn btn-sm btn-primary">@Localizer["Common_Save"]</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary cancel-rename">@Localizer["Common_Cancel"]</button>
                    </form>
                </li>
            }
        </ul>
    </div>
}
else if (Model.ActiveTab == "users")
{
    <div class="settings-panel">
        <form asp-action="CreateUser" method="post" class="row g-2 mb-3">
            <div class="col-auto">
                <input type="email" name="email" class="form-control" placeholder="@Localizer["Settings_NewUserEmailPlaceholder"]" required />
            </div>
            <div class="col-auto">
                <input type="password" name="password" class="form-control" placeholder="@Localizer["Settings_NewUserPasswordPlaceholder"]" required minlength="6" />
            </div>
            <div class="col-auto">
                <input type="password" name="confirmPassword" class="form-control" placeholder="@Localizer["Settings_ConfirmPasswordPlaceholder"]" required minlength="6" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">@Localizer["Settings_AddUser"]</button>
            </div>
        </form>
        <ul class="list-group">
            @foreach (var user in Model.Users)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    @user.Email
                    @if (user.Id != Model.CurrentUserId)
                    {
                        <form asp-action="DeleteUser" method="post" onsubmit="return confirm('@Localizer["Settings_ConfirmDeleteUser"]');">
                            <input type="hidden" name="id" value="@user.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">@Localizer["Common_Delete"]</button>
                        </form>
                    }
                </li>
            }
        </ul>
    </div>
}
else
{
    <div class="settings-panel">
        <form asp-action="UpdateCurrency" method="post" class="col-md-6">
            <div class="mb-3">
                <label class="form-label">@Localizer["Settings_PrimaryCurrency"]</label>
                <select name="primaryCurrency" class="form-select">
                    <option value="USD" selected="@(Model.CurrencySettings.PrimaryCurrency == Mark1.Models.Currency.USD)">USD</option>
                    <option value="CRC" selected="@(Model.CurrencySettings.PrimaryCurrency == Mark1.Models.Currency.CRC)">CRC</option>
                </select>
                <div class="form-text">@Localizer["Settings_PrimaryCurrencyHint"]</div>
            </div>
            <div class="mb-3">
                <label class="form-label">@Localizer["Settings_FixedRateLabel"]</label>
                <input type="number" step="0.01" name="fixedExchangeRate" class="form-control" value="@Model.CurrencySettings.FixedExchangeRate" required />
            </div>
            <div class="mb-3 form-check">
                <input type="checkbox" name="useLiveRate" value="true" class="form-check-input" id="useLiveRate" checked="@Model.CurrencySettings.UseLiveRate" />
                <label class="form-check-label" for="useLiveRate">@Localizer["Settings_UseLiveRate"]</label>
            </div>
            @if (Model.CurrencySettings.UseLiveRate)
            {
                <p class="text-muted">
                    @Localizer["Settings_LiveRateNow"]
                    @if (Model.LiveRatePreview.HasValue && Model.LiveRatePreview != Model.CurrencySettings.FixedExchangeRate)
                    {
                        <strong>@Model.LiveRatePreview.Value.ToString("N2")</strong>
                    }
                    else
                    {
                        <span>@Localizer["Settings_LiveRateUnavailable"]</span>
                    }
                </p>
            }
            <button type="submit" class="btn btn-primary">@Localizer["Common_Save"]</button>
        </form>
    </div>
}

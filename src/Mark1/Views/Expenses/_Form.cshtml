@model Mark1.Models.ViewModels.ExpenseFormViewModel

@if (TempData["ExpenseTransferWarning"] != null)
{
    <div class="alert alert-warning col-md-6">@TempData["ExpenseTransferWarning"]</div>
}

<form method="post" class="col-md-6">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label">@Localizer["Common_Description"]</label>
        <input asp-for="Description" class="form-control" autofocus />
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-6 mb-3">
            <label asp-for="Amount" class="form-label">@Localizer["Common_Amount"]</label>
            <input asp-for="Amount" class="form-control" onfocus="this.select()" />
            <span asp-validation-for="Amount" class="text-danger"></span>
        </div>
        <div class="col-6 mb-3">
            <label asp-for="Currency" class="form-label">@Localizer["Common_Currency"]</label>
            <select asp-for="Currency" class="form-select" asp-items="Html.GetEnumSelectList<Mark1.Models.Currency>()"></select>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Date" class="form-label">@Localizer["Common_Date"]</label>
        <input asp-for="Date" class="form-control" />
        <span asp-validation-for="Date" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CategoryId" class="form-label">@Localizer["Common_Category"]</label>
        <select asp-for="CategoryId" class="form-select" asp-items="Model.CategoryOptions">
            <option value="">@Localizer["Common_SelectCategory"]</option>
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="AccountId" class="form-label">@Localizer["Common_Account"]</label>
        <select asp-for="AccountId" class="form-select" asp-items="Model.AccountOptions">
            <option value="">@Localizer["Common_SelectAccount"]</option>
        </select>
        <span asp-validation-for="AccountId" class="text-danger"></span>
    </div>

    <div class="mb-3 form-check">
        <input asp-for="RepeatsMonthly" class="form-check-input" />
        <label asp-for="RepeatsMonthly" class="form-check-label">@Localizer["Common_RepeatsMonthly"]</label>
    </div>

    <div class="mb-3 form-check">
        <input asp-for="IsPaid" class="form-check-input" />
        <label asp-for="IsPaid" class="form-check-label">@Localizer["Expenses_Paid"]</label>
    </div>

    <div class="mb-3 form-check">
        <input asp-for="IsTransferToSavings" class="form-check-input transfer-target-check" data-other-target="IsTransferToRetained" />
        <label asp-for="IsTransferToSavings" class="form-check-label">@Localizer["Expenses_TransferToSavings"]</label>
    </div>

    <div class="mb-3 form-check">
        <input asp-for="IsTransferToRetained" class="form-check-input transfer-target-check" data-other-target="IsTransferToSavings" />
        <label asp-for="IsTransferToRetained" class="form-check-label">@Localizer["Expenses_TransferToRetained"]</label>
    </div>

    <div class="mb-3 savings-purpose-group" style="display:@((Model.IsTransferToSavings || Model.IsTransferToRetained) ? "block" : "none");">
        <label asp-for="SavingsPurposeId" class="form-label">@Localizer["Expenses_SavingsPurpose"]</label>
        <select asp-for="SavingsPurposeId" class="form-select" asp-items="Model.SavingsPurposeOptions">
            <option value="">@Localizer["Expenses_SelectSavingsPurpose"]</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">@Localizer["Common_Save"]</button>
    <a href="@(Model.ReturnUrl != null && Url.IsLocalUrl(Model.ReturnUrl) ? Model.ReturnUrl : Url.Action("Index"))" class="btn btn-outline-secondary">@Localizer["Common_Cancel"]</a>
</form>

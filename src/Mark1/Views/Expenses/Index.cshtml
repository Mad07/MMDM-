@model Mark1.Models.ViewModels.TransactionFilterViewModel<Mark1.Models.Expense>
@{
    ViewData["Title"] = Localizer["Expenses_Title"];
    var returnUrl = Context.Request.Path + Context.Request.QueryString;

    Dictionary<string, string> SortRoute(string column)
    {
        var dict = new Dictionary<string, string>();
        if (!string.IsNullOrEmpty(Model.Month)) dict["month"] = Model.Month;
        if (Model.DateFrom.HasValue) dict["dateFrom"] = Model.DateFrom.Value.ToString("yyyy-MM-dd");
        if (Model.DateTo.HasValue) dict["dateTo"] = Model.DateTo.Value.ToString("yyyy-MM-dd");
        if (Model.CategoryId.HasValue) dict["categoryId"] = Model.CategoryId.Value.ToString();
        if (Model.AccountId.HasValue) dict["accountId"] = Model.AccountId.Value.ToString();
        if (Model.Currency.HasValue) dict["currency"] = Model.Currency.Value.ToString();
        dict["sortBy"] = column;
        dict["sortDir"] = (Model.SortBy == column && !Model.SortDescending) ? "desc" : "asc";
        return dict;
    }
}

<div class="d-flex justify-content-between align-items-center">
    <h1 class="page-title">@Localizer["Expenses_Title"]</h1>
    <div>
        <a asp-action="Create" asp-route-returnUrl="@returnUrl" class="btn btn-primary">@Localizer["Expenses_Add"]</a>
        <a asp-action="Deleted" class="btn btn-outline-secondary">@Localizer["Expenses_Deleted"]</a>
    </div>
</div>

<ul class="nav nav-pills month-tabs mb-3">
    @foreach (var tab in Model.MonthTabs)
    {
        <li class="nav-item">
            <a class="nav-link @(Model.Month == tab.Value ? "active" : "")" asp-action="Index" asp-route-month="@tab.Value">@tab.Label</a>
        </li>
    }
</ul>

<form method="get" class="filter-bar row g-2 mb-3">
    <input type="hidden" name="month" value="@Model.Month" />
    <div class="col-auto">
        <input type="date" name="dateFrom" class="form-control" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" placeholder="@Localizer["Common_Date"]" />
    </div>
    <div class="col-auto">
        <input type="date" name="dateTo" class="form-control" value="@Model.DateTo?.ToString("yyyy-MM-dd")" placeholder="@Localizer["Common_Date"]" />
    </div>
    <div class="col-auto">
        <select name="categoryId" class="form-select" asp-items="Model.CategoryOptions">
            <option value="">@Localizer["Common_AllCategories"]</option>
        </select>
    </div>
    <div class="col-auto">
        <select name="accountId" class="form-select" asp-items="Model.AccountOptions">
            <option value="">@Localizer["Common_AllAccounts"]</option>
        </select>
    </div>
    <div class="col-auto">
        <select name="currency" class="form-select" asp-items="Html.GetEnumSelectList<Mark1.Models.Currency>()">
            <option value="">@Localizer["Common_AllCurrencies"]</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">@Localizer["Common_Filter"]</button>
    </div>
</form>

<table class="table table-hover expense-table">
    <thead>
        <tr>
            <th>
                <a asp-action="Index" asp-all-route-data="@(SortRoute("date"))" class="sort-link">
                    @Localizer["Common_Date"]
                    @if (Model.SortBy == "date")
                    {
                        <i class="bi @(Model.SortDescending ? "bi-caret-down-fill" : "bi-caret-up-fill")"></i>
                    }
                </a>
            </th>
            <th>
                <a asp-action="Index" asp-all-route-data="@(SortRoute("description"))" class="sort-link">
                    @Localizer["Common_Description"]
                    @if (Model.SortBy == "description")
                    {
                        <i class="bi @(Model.SortDescending ? "bi-caret-down-fill" : "bi-caret-up-fill")"></i>
                    }
                </a>
            </th>
            <th>
                <a asp-action="Index" asp-all-route-data="@(SortRoute("category"))" class="sort-link">
                    @Localizer["Common_Category"]
                    @if (Model.SortBy == "category")
                    {
                        <i class="bi @(Model.SortDescending ? "bi-caret-down-fill" : "bi-caret-up-fill")"></i>
                    }
                </a>
            </th>
            <th>
                <a asp-action="Index" asp-all-route-data="@(SortRoute("account"))" class="sort-link">
                    @Localizer["Common_Account"]
                    @if (Model.SortBy == "account")
                    {
                        <i class="bi @(Model.SortDescending ? "bi-caret-down-fill" : "bi-caret-up-fill")"></i>
                    }
                </a>
            </th>
            <th class="text-end">
                <a asp-action="Index" asp-all-route-data="@(SortRoute("amount"))" class="sort-link">
                    @Localizer["Common_Amount"]
                    @if (Model.SortBy == "amount")
                    {
                        <i class="bi @(Model.SortDescending ? "bi-caret-down-fill" : "bi-caret-up-fill")"></i>
                    }
                </a>
            </th>
            <th class="text-center">
                <a asp-action="Index" asp-all-route-data="@(SortRoute("paid"))" class="sort-link">
                    @Localizer["Expenses_Paid"]
                    @if (Model.SortBy == "paid")
                    {
                        <i class="bi @(Model.SortDescending ? "bi-caret-down-fill" : "bi-caret-up-fill")"></i>
                    }
                </a>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var expense in Model.Items)
        {
            <tr>
                <td>@expense.Date.ToString("MMM d, yyyy")</td>
                <td>
                    @expense.Description
                    @if (expense.RepeatsMonthly)
                    {
                        <span class="badge bg-secondary">@Localizer["Common_RepeatsMonthly"]</span>
                    }
                </td>
                <td>@CategoryDisplay.Localize(expense.Category?.Name, Localizer)</td>
                <td>@AccountDisplay.Localize(expense.Account?.Name, Localizer)</td>
                <td class="text-end amount-expense">@expense.Amount.ToString("N2") @expense.Currency</td>
                <td class="text-center">
                    <form asp-action="TogglePaid" asp-route-id="@expense.Id" method="post" class="d-inline ajax-toggle-form">
                        <input type="checkbox" class="form-check-input" checked="@expense.IsPaid" title="@Localizer["Expenses_Paid"]" />
                    </form>
                </td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@expense.Id" asp-route-returnUrl="@returnUrl" class="btn btn-sm btn-outline-secondary btn-icon" title="@Localizer["Common_Edit"]">
                        <i class="bi bi-pencil-square"></i>
                        <span class="visually-hidden">@Localizer["Common_Edit"]</span>
                    </a>
                    <form asp-action="Delete" asp-route-id="@expense.Id" method="post" class="d-inline" onsubmit="return confirm('@Localizer["Expenses_ConfirmDelete"]');">
                        <button type="submit" class="btn btn-sm btn-outline-danger btn-icon" title="@Localizer["Common_Delete"]">
                            <i class="bi bi-trash"></i>
                            <span class="visually-hidden">@Localizer["Common_Delete"]</span>
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Items.Any())
{
    <p class="text-muted">@Localizer["Expenses_NoneFound"]</p>
}
else
{
    <div class="transaction-totals">
        <div><span class="total-label">@Localizer["Expenses_TotalUsd"]</span><span class="total-value amount-expense">$@Model.TotalUsd.ToString("N2")</span></div>
        <div><span class="total-label">@Localizer["Expenses_TotalCrc"]</span><span class="total-value amount-expense">&#8353;@Model.TotalCrc.ToString("N2")</span></div>
    </div>
}
